# Copy to .env (git-ignored) and change every value before exposing anything.
WAYHOUSE_CONTROLLER_TOKEN=change-me-controller
WAYHOUSE_AGGREGATOR_TOKEN=change-me-aggregator
# What wayhouse presents when pushing to the aggregator; must differ from the one above.
WAYHOUSE_INGEST_TOKEN=change-me-ingest
WAYHOUSE_UI_PASSWORD=change-me-ui

# Needed only with compose.tunnel.yml:
# WAYHOUSE_TUNNEL_ENDPOINT=203.0.113.10:51820
