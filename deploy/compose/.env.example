# Copy to .env (git-ignored) and change every value before exposing anything.
GSP_CONTROLLER_TOKEN=change-me-controller
GSP_AGGREGATOR_TOKEN=change-me-aggregator
# What gsp presents when pushing to the aggregator; must differ from the one above.
GSP_INGEST_TOKEN=change-me-ingest
GSP_UI_PASSWORD=change-me-ui

# Needed only with compose.tunnel.yml:
# GSP_TUNNEL_ENDPOINT=203.0.113.10:51820
